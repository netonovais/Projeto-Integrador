body {
  font-family: Arial, Helvetica, sans-serif;
  background-color: #f8f9fa;
  color: #212529;
}

.hero-section {
  min-height: 85vh;
  background: linear-gradient(135deg, rgba(13, 110, 253, 0.9), rgba(33, 37, 41, 0.95)),
              url("../img/banner.jpg") center/cover no-repeat;
}

.hero-section h1 {
  max-width: 900px;
  margin: 0 auto;
}

.hero-section p {
  max-width: 700px;
  margin: 0 auto;
}

section {
  scroll-margin-top: 90px;
}

.card {
  border-radius: 16px;
}

.dashboard-box {
  min-height: 320px;
  border: 2px dashed #ced4da;
  border-radius: 12px;
  background-color: #fff;
}

footer {
  margin-top: 0;
}
