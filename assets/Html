<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Projeto R.E.G.I.I.M.E.N.T.O.</title>

  <!-- Bootstrap CSS -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />

  <!-- Bootstrap Icons -->
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
  />

  <!-- CSS próprio -->
  <link rel="stylesheet" href="ativos/css/style.css" />
</head>
<body>

  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
    <div class="container">
      <a class="navbar-brand fw-bold" href="#">R.E.G.I.I.M.E.N.T.O.</a>

      <button
        class="navbar-toggler"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#menuNav"
      >
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="menuNav">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item"><a class="nav-link" href="#sobre">Sobre</a></li>
          <li class="nav-item"><a class="nav-link" href="#pesquisa">Pesquisas</a></li>
          <li class="nav-item"><a class="nav-link" href="#eventos">Eventos</a></li>
          <li class="nav-item"><a class="nav-link" href="#dashboard">Dashboard</a></li>
          <li class="nav-item"><a class="nav-link" href="#contato">Contato</a></li>
        </ul>
      </div>
    </div>
  </nav>

  <!-- Hero -->
  <header class="hero-section d-flex align-items-center text-white">
    <div class="container text-center">
      <h1 class="display-5 fw-bold">Plataforma Digital do Grupo R.E.G.I.I.M.E.N.T.O.</h1>
      <p class="lead mt-3">
        Centralizando pesquisas, eventos, publicações e dashboards acadêmicos.
      </p>
      <a href="#sobre" class="btn btn-primary btn-lg mt-3">Conhecer Projeto</a>
    </div>
  </header>

  <!-- Sobre -->
  <section id="sobre" class="py-5">
    <div class="container">
      <div class="row align-items-center g-4">
        <div class="col-md-6">
          <h2 class="fw-bold mb-3">Sobre o Projeto</h2>
          <p>
            Este projeto propõe uma plataforma digital para o grupo de pesquisa
            R.E.G.I.I.M.E.N.T.O., com foco em centralizar informações institucionais,
            publicações, eventos e dados analíticos.
          </p>
          <p>
            O objetivo é melhorar a comunicação com a comunidade acadêmica e facilitar
            o acesso às produções e iniciativas do grupo.
          </p>
        </div>
        <div class="col-md-6">
          <div class="card border-0 shadow-sm p-4">
            <h5 class="fw-bold">Objetivos principais</h5>
            <ul class="mb-0">
              <li>Centralizar informações acadêmicas</li>
              <li>Divulgar pesquisas e eventos</li>
              <li>Exibir dashboards interativos</li>
              <li>Engajar novos estudantes e pesquisadores</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Linhas de pesquisa -->
  <section id="pesquisa" class="py-5 bg-light">
    <div class="container">
      <div class="text-center mb-5">
        <h2 class="fw-bold">Linhas de Pesquisa</h2>
        <p class="text-muted">Principais áreas de atuação do grupo.</p>
      </div>

      <div class="row g-4">
        <div class="col-md-4">
          <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
              <i class="bi bi-diagram-3 fs-1 text-primary"></i>
              <h5 class="card-title mt-3">Arquitetura da Informação</h5>
              <p class="card-text">
                Estudos relacionados à organização, estruturação e acesso à informação.
              </p>
            </div>
          </div>
        </div>

        <div class="col-md-4">
          <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
              <i class="bi bi-cpu fs-1 text-primary"></i>
              <h5 class="card-title mt-3">PLN e Ontologias</h5>
              <p class="card-text">
                Pesquisas em processamento de linguagem natural e engenharia de ontologias.
              </p>
            </div>
          </div>
        </div>

        <div class="col-md-4">
          <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
              <i class="bi bi-bar-chart-line fs-1 text-primary"></i>
              <h5 class="card-title mt-3">MIA e Dashboards</h5>
              <p class="card-text">
                Visualização de dados e monitoramento da Arquitetura da Informação Multimodal.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Eventos -->
  <section id="eventos" class="py-5">
    <div class="container">
      <div class="text-center mb-5">
        <h2 class="fw-bold">Eventos e Publicações</h2>
        <p class="text-muted">Espaço inicial para divulgação acadêmica.</p>
      </div>

      <div class="row g-4">
        <div class="col-md-6">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
              <h5 class="fw-bold">Próximos Eventos</h5>
              <ul class="mt-3">
                <li>Workshop de Arquitetura da Informação</li>
                <li>Colóquio sobre Ciência Arquivística Computacional</li>
                <li>Seminário sobre Multimodalidade</li>
              </ul>
            </div>
          </div>
        </div>

        <div class="col-md-6">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
              <h5 class="fw-bold">Publicações em Destaque</h5>
              <ul class="mt-3">
                <li>Teses e dissertações do grupo</li>
                <li>Artigos científicos recentes</li>
                <li>Produções em IA e Arquivística</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Dashboard -->
  <section id="dashboard" class="py-5 bg-light">
    <div class="container">
      <div class="text-center mb-5">
        <h2 class="fw-bold">Prévia do Dashboard</h2>
        <p class="text-muted">Área reservada para gráficos e indicadores acadêmicos.</p>
      </div>

      <div class="row g-4">
        <div class="col-lg-8">
          <div class="card border-0 shadow-sm p-3">
            <h5 class="fw-bold mb-3">Produção por Subárea</h5>
            <div class="dashboard-box d-flex justify-content-center align-items-center">
              <p class="mb-0 text-muted">Gráfico será renderizado aqui</p>
            </div>
          </div>
        </div>

        <div class="col-lg-4">
          <div class="card border-0 shadow-sm p-3 h-100">
            <h5 class="fw-bold mb-3">Indicadores</h5>
            <ul class="list-group list-group-flush">
              <li class="list-group-item">24 mestres titulados</li>
              <li class="list-group-item">24 doutores titulados</li>
              <li class="list-group-item">Atuação desde 2009</li>
              <li class="list-group-item">Integração com INTERPARES TRUST AI</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Rodapé -->
  <footer id="contato" class="bg-dark text-white py-4">
    <div class="container text-center">
      <p class="mb-1 fw-bold">Projeto Integrador I - CEUB</p>
      <p class="mb-0">Protótipo acadêmico desenvolvido para o grupo R.E.G.I.I.M.E.N.T.O.</p>
    </div>
  </footer>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <!-- JS próprio -->
  <script src="ativos/js/app.js"></script>
</body>
</html>
